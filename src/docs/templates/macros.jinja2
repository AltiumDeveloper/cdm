{#- GraphQL interfaces documented under /types/interfaces/ (verified against production
    introspection 2026-09-29). Temporary: Phase 2 derives the kind from the API snapshot. -#}
{%- macro platform_api_url(element) -%}
  {%- if 'platformAPI' in element.annotations -%}
    {%- set name = element.annotations["platformAPI"].value -%}
    {%- set kind = "interfaces" if name in ["Bom", "BomItemElement", "GloEvtSubscription"] else "objects" -%}
    [{{ name }}](https://altiumdeveloper.github.io/platform-api-docs/types/{{ kind }}/{{ name }})
  {%- endif -%}
{% endmacro -%}

{%- macro slot_range_url(slot_range) -%}
  {%- set element = schemaview.get_element(slot_range) -%}
  {%- if element.__class__.__name__ == "ClassDefinition" -%}
  [{{ element.title if element.title else gen.name(element) }}]( ../classes/{{ slot_range }}.md )
  {%- else -%}
  {{ gen.link(slot_range) }} 
  {%- endif -%}
{%- endmacro -%}

{%- macro slot_title(slot) -%}
  {{ slot.title if slot.title else gen.name(slot) }}
{%- endmacro -%}

{%- macro slot_url(slot) -%}
  [{{ slot_title(slot) }}]( ../../slots/{{slot.name}})
{%- endmacro -%}