{%- macro slot_range_url(slot_range) -%}
  {%- set element = schemaview.get_element(slot_range) -%}
  {%- if element.__class__.__name__ == "ClassDefinition" -%}
  [{{ element.title if element.title else gen.name(element) }}]( ../classes/{{ slot_range }}.md )
  {%- else -%}
  {{ gen.link(slot_range) }} 
  {%- endif -%}
{%- endmacro -%}

{%- macro slot_title(slot) -%}
  {{ slot.title if slot.title else gen.name(slot) }}
{%- endmacro -%}

{%- macro slot_url(slot) -%}
  [{{ slot_title(slot) }}]( ../../slots/{{slot.name}})
{%- endmacro -%}

{%- macro hub_panel(h) -%}
!!! abstract "In the product"
{%- if h.terms %}
    Known as: {% for t in h.terms %}**{{ t.text }}**{% if t.contexts %} ({{ t.contexts | join(", ") }}){% endif %}{% if not loop.last %}; {% endif %}{% endfor %}
{% endif %}
{%- if h.links %}
{% for l in h.links %}
    - [{{ l.text }}]({{ l.url }}){% if l.primary %} *(primary)*{% endif %}
{%- endfor %}
{%- elif h.product_docs_none %}
    No public product documentation exists for this concept.
{%- else %}
    No product documentation linked yet.
{%- endif %}

!!! abstract "In the API"
{%- if h.api %}
    Type: {% if h.api.url %}[`{{ h.api.type_name }}`]({{ h.api.url }}){% else %}`{{ h.api.type_name }}`{% endif %} {% if h.api.kind %}({{ h.api.kind | lower }}){% endif %}
{%- elif h.api_missing %}
    `{{ h.api_missing }}` is not in the Platform API snapshot.
{%- elif not h.nexar and not h.nexar_missing %}
    No Platform API type.
{%- endif %}
{%- if h.nexar_missing %}

    `{{ h.nexar_missing }}` is not in the Nexar API snapshot.
{%- endif %}
{%- if h.nexar %}

    Nexar type: `{{ h.nexar.type_name }}` ([Octopart API]({{ h.nexar.url }}))
{%- endif %}
{% if h.mappings %}

!!! abstract "In standards"
{% for m in h.mappings %}
    - {{ m.relation }}: {% if m.url %}[{{ m.text }}]({{ m.url }}){% else %}`{{ m.text }}`{% endif %}
{%- endfor %}
{% endif %}
{%- endmacro -%}

{%- macro api_type_link(h) -%}
  {%- if h.api -%}
    {%- if h.api.url -%}[`{{ h.api.type_name }}`]({{ h.api.url }}){%- else -%}`{{ h.api.type_name }}`{%- endif -%}
  {%- elif h.nexar -%}[`{{ h.nexar.type_name }}`]({{ h.nexar.url }}) (Nexar)
  {%- elif h.api_missing -%}`{{ h.api_missing }}` (not in Platform API snapshot)
  {%- elif h.nexar_missing -%}`{{ h.nexar_missing }}` (not in Nexar API snapshot)
  {%- endif -%}
{%- endmacro -%}

{%- macro subset_title(name) -%}
  {%- set subsets = schemaview.all_subsets() -%}
  {{- subsets[name].title if name in subsets and subsets[name].title else name -}}
{%- endmacro -%}

{#- Link to a class page labelled with the class title (falls back to the class name). -#}
{%- macro class_link(name, prefix='../') -%}
  {%- set c = schemaview.get_class(name) -%}
  [{{ c.title if c and c.title else name }}]({{ prefix }}classes/{{ name }}.md)
{%- endmacro -%}

{#- Kind of a class as the CDM names it: "entity", "resource" or "event" (descendants of core_Entity, core_Resource,
    core_Event; the base itself is not counted), otherwise "other" (base types and mixins). -#}
{%- macro cdm_kind(name) -%}
  {%- set ancestors = schemaview.class_ancestors(name, mixins=False, reflexive=False) -%}
  {%- if 'core_Entity' in ancestors -%}entity
  {%- elif 'core_Resource' in ancestors -%}resource
  {%- elif 'core_Event' in ancestors -%}event
  {%- else -%}other
  {%- endif -%}
{%- endmacro -%}

{#- Link to a field (slot) page labelled with the field title (falls back to the slot name); prefix is the path to the
    slots/ directory from the current page. -#}
{%- macro slot_link(name, prefix='') -%}
  {%- set sl = schemaview.get_slot(name) -%}
  [{{ sl.title if sl and sl.title else name }}]({{ prefix }}{{ name }}.md)
{%- endmacro -%}
