## Inheritance

{% set chain = [] %}
{% set ns = namespace(c=element.is_a) %}
{% for _ in range(30) %}{% if ns.c %}{% set _ = chain.insert(0, ns.c) %}{% set ns.c = schemaview.get_class(ns.c).is_a %}{% endif %}{% endfor %}
{% for a in chain -%}
{{ '    ' * loop.index0 }}* {{ class_link(a) }}
{% endfor -%}
{{ '    ' * chain|length }}* **{{ title }}**{% if element.mixins %} (mixins: {% for m in element.mixins %}{{ class_link(m) }}{% if not loop.last %}, {% endif %}{% endfor %}){% endif %}
{% for c in schemaview.class_children(element.name, mixins=False) -%}
{{ '    ' * (chain|length + 1) }}* {{ class_link(c) }}
{% endfor %}
{% else %}
<!-- no inheritance hierarchy -->
{% endif %}

