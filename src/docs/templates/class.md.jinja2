---
comments: true

{% if 'maturity' in element.annotations -%}
{%- set maturity = element.annotations["maturity"].value -%}
tags:
  - {{ maturity | lower }}
{%- endif %}

---

{% from "macros.jinja2" import hub_panel with context %}
{% from "macros.jinja2" import class_link with context %}
{% from "macros.jinja2" import slot_url with context %}
{% from "macros.jinja2" import slot_range_url with context %}

{%- if element.title %}
    {%- set title = element.title -%}
{%- else %}
    {%- if gen.use_class_uris -%}
        {%- set title = element.name -%}
    {%- else -%}
        {%- set title = gen.name(element) -%}
    {%- endif -%}
{%- endif -%}

{% macro compute_range(slot) -%}
    {%- if slot.any_of or slot.exactly_one_of -%}
        {%- for subslot_range in schemaview.slot_range_as_union(slot) -%}
            {%- if not subslot_range == "Any" -%}
                {{ slot_range_url(subslot_range) }}
            {%- if not loop.last -%}
                &nbsp;or&nbsp;<br />
            {%- endif -%}
            {%- endif -%}            
        {%- endfor -%}
    {%- else -%}
        {{ slot_range_url(slot.range) }}
    {%- endif -%}
{% endmacro %}

# {{ title }}  {% if element.deprecated %} <span style="color: red;"><strong> (DEPRECATED) </strong></span> {% endif %}

{% set iri = schemaview.get_uri(element, true, true, false, false) %}
IRI: [{{ iri }}]({{ iri }})
{ .page-subtitle }

{#- The class's own GRID template, else the nearest ancestor's (annotations are not inherited in LinkML) -#}
{% set g = namespace(value=element.annotations["grid"].value if 'grid' in element.annotations else none, owner=none, c=element.is_a) %}
{% for _ in range(30) %}{% if g.value is none and g.c %}{% set p = schemaview.get_class(g.c) %}{% if 'grid' in p.annotations %}{% set g.value = p.annotations["grid"].value %}{% set g.owner = g.c %}{% endif %}{% set g.c = p.is_a %}{% endif %}{% endfor %}
{% if g.value %}
GRID: `{{ g.value }}`{% if g.owner %} (from {{ class_link(g.owner) }}){% endif %}
{ .page-subtitle }
{% endif %}

